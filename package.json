{
  "name": "kulstu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-wasm.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "npm run assets && tsc -b && vite build --mode pages --outDir dist-pages && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "test": "node --import ./test/setup.mjs --test \"test/*.test.ts\"",
    "test:model": "node --import ./test/setup.mjs --test \"test/model/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.0.0",
    "@mediapipe/tasks-vision": "^0.10.14",
    "onnxruntime-web": "^1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
