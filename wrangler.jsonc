{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kulstu",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  // Worker phục vụ web tĩnh (dist/) và API /api/erase (xoá vật thể bằng AI trên máy chủ, xem worker/index.ts).
  "main": "worker/index.ts",
  // Tệp tĩnh được phục vụ trước, không qua Worker. Không bật "single-page-application": app dùng địa chỉ dạng #/,
  // nên tệp thiếu trả 404 thật thay vì index.html (từng khiến model AI tải nhầm trang HTML).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Workers AI: model Stable Diffusion Inpainting dùng cho /api/erase
  "ai": {
    "binding": "AI"
  },
  // Cần cho bản xem trước của pull request (npx wrangler preview).
  "previews": {}
}
